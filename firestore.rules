rules_version = '2';

// Everyone can read the word list; only the admin can change it.
// Replace ADMIN_UID_HERE with the admin's User UID (same value as src/firebaseConfig.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ADMIN_UID_HERE';
    }

    function validWord() {
      let w = request.resource.data;
      return w.keys().hasOnly(['greek', 'english', 'pos', 'list', 'createdAt'])
        && w.greek is string && w.greek.size() > 0 && w.greek.size() < 500
        && w.english is string && w.english.size() > 0 && w.english.size() < 1000
        && w.pos in ['noun', 'verb', 'adjective', 'adverb', 'pronoun', 'preposition', 'conjunction', 'other']
        && w.list is int && w.list > 0
        && w.createdAt is number;
    }

    match /words/{wordId} {
      allow read: if true;
      allow create, update: if isAdmin() && validWord();
      allow delete: if isAdmin();
    }
  }
}
